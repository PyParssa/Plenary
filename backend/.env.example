# ==============================================================================
# Plenary API Environment Configuration Template
# ==============================================================================

# Supabase Service Role & Project Configuration
# Found under Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Resend Email Delivery API
# Used to deliver 6-digit verification codes to users
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Plenary <noreply@yourdomain.com>"

# Google Sheets / Apps Script Integration
# Used for storing waitlist and signup entries
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your-google-apps-script-id/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="your-google-sheets-webhook-secret"

# CORS Configuration
# Comma-separated list of allowed origins (e.g., your local frontend and deployed domains)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Application Environment (production | development)
NODE_ENV="production"
